{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Flink": {
    "Protocol": "http",
    "JobManager": {
      "BaseUrl": "http://localhost:8081"
    },
    "SqlGateway": {
      "BaseUrl": "http://localhost:8083"
    }
  },
  "FlinkJobGateway": {
    "BaseUrl": "http://localhost:8080/",
    "HttpTimeout": "00:05:00",
    "MaxRetries": 3,
    "RetryDelay": "00:00:01",
    "UseHttps": false
  }
}