<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>FlinkDotNet.Util</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Authors>FlinkDotnet Team</Authors>
    <Description>.NET Utilities for Apache Flink - Common utilities and helpers matching PyFlink util module</Description>
    <PackageTags>Apache Flink;Streaming;Real-time;Data Processing;Utilities</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/devstress/FlinkDotnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FlinkDotNet.Common/FlinkDotNet.Common.csproj" />
  </ItemGroup>

</Project>