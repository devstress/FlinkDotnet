<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>FlinkDotnet</PackageId>
    <PackageVersion>1.0.1</PackageVersion>
    <Authors>FlinkDotnet Team</Authors>
    <Description>FlinkDotnet - Complete .NET SDK for Apache Flink 2.1. Build streaming jobs with C# fluent API, including DataStream API, Kafka connectors, state management, and job submission. All-in-one package for Apache Flink development in .NET.</Description>
    <PackageTags>Apache Flink;Streaming;Real-time;Data Processing;DataStream;Kafka;FlinkDotnet</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/devstress/FlinkDotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flink.JobBuilder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FlinkDotNet.Common/FlinkDotNet.Common.csproj" PrivateAssets="All" />
    <ProjectReference Include="../Flink.JobBuilder/Flink.JobBuilder.csproj" PrivateAssets="All" />
    <ProjectReference Include="../FlinkDotNet.JobGateway/FlinkDotNet.JobGateway.csproj" PrivateAssets="All" />
  </ItemGroup>

  <!-- Include README.md in the NuGet package -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Include referenced project DLLs in the package -->
  <Target Name="IncludeReferencedProjectsInPackage" DependsOnTargets="ResolveReferences" BeforeTargets="GenerateNuspec">
    <ItemGroup>
      <_PackageFiles Include="$(OutDir)FlinkDotNet.Common.dll">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
        <Visible>false</Visible>
      </_PackageFiles>
      <_PackageFiles Include="$(OutDir)Flink.JobBuilder.dll">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
        <Visible>false</Visible>
      </_PackageFiles>
      <_PackageFiles Include="$(OutDir)FlinkDotNet.JobGateway.dll">
        <PackagePath>lib/$(TargetFramework)</PackagePath>
        <Visible>false</Visible>
      </_PackageFiles>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions" Version="22.0.16" />
    <PackageReference Include="System.Text.Json" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.7" />
    <PackageReference Include="Confluent.Kafka" Version="2.11.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

</Project>
