<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>FlinkDotnet</PackageId>
    <PackageVersion>2.0.0</PackageVersion>
    <Authors>FlinkDotnet Team</Authors>
    <Description>FlinkDotnet - Complete .NET SDK for Apache Flink 2.1. Build streaming jobs with C# fluent API, including DataStream API, Kafka connectors, state management, and job submission. All-in-one package for Apache Flink development in .NET.</Description>
    <PackageTags>Apache Flink;Streaming;Real-time;Data Processing;DataStream;Kafka;FlinkDotnet</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/devstress/FlinkDotnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flink.JobBuilder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../FlinkDotNet.Common/FlinkDotNet.Common.csproj" />
    <ProjectReference Include="../Flink.JobBuilder/Flink.JobBuilder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions" Version="22.0.16" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Confluent.Kafka" Version="2.11.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

</Project>
