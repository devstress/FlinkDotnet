<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Allow disabling the Java runner build with /p:BuildFlinkRunner=false -->
    <BuildFlinkRunner>true</BuildFlinkRunner>
    <!-- Define the FlinkIRRunner directory relative to this project -->
    <FlinkIRRunnerDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\FlinkIRRunner'))</FlinkIRRunnerDir>
    <!-- Define the output JAR paths -->
    <FlinkIRRunnerJarPath25>$(FlinkIRRunnerDir)\target\flink-ir-runner.jar</FlinkIRRunnerJarPath25>
    <FlinkIRRunnerJarPath17>$(FlinkIRRunnerDir)\target\flink-ir-runner-java17.jar</FlinkIRRunnerJarPath17>
    <!-- Define the local JAR copy path -->
    <LocalJarPath>$(MSBuildProjectDirectory)\flink-ir-runner.jar</LocalJarPath>
    <!-- Heuristic JDK 25 detection from JAVA_HOME path -->
    <JavaHome>$(JAVA_HOME)</JavaHome>
    <IsJdk25>$([System.String]::Copy('$(JavaHome)').Contains('25'))</IsJdk25>
  </PropertyGroup>

  <!-- Maven auto-installation configuration -->
  <PropertyGroup>
    <MavenVersion>3.9.11</MavenVersion>
    <MavenDownloadUrl>https://dlcdn.apache.org/maven/maven-3/$(MavenVersion)/binaries/apache-maven-$(MavenVersion)-bin.zip</MavenDownloadUrl>
    <ToolsDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\tools'))</ToolsDir>
    <MavenInstallDir>$(ToolsDir)\apache-maven-$(MavenVersion)</MavenInstallDir>
    <MavenBinPath>$(MavenInstallDir)\bin</MavenBinPath>
    <MavenZipPath>$(ToolsDir)\maven-$(MavenVersion).zip</MavenZipPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.3" />
    <PackageReference Include="System.Text.Json" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning" Version="5.1.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Versioning.ApiExplorer" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Flink.JobBuilder/Flink.JobBuilder.csproj" />
  </ItemGroup>

  <!--
    Ensure Maven and Java are available before building.
    This target automatically downloads and installs Maven if not found in PATH.
  -->
  <Target Name="EnsureBuildTools" BeforeTargets="BuildFlinkRunner" Condition="'$(BuildFlinkRunner)' != 'false'">
    <Message Text="(Flink.JobGateway) Checking for build tools..." Importance="High" />

    <!-- Detect OS for cross-platform Maven detection -->
    <PropertyGroup>
      <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
      <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
      <IsMacOS Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsMacOS>
    </PropertyGroup>

    <!-- Check if Maven exists in PATH (Windows) -->
    <Exec Command="where mvn"
          ContinueOnError="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low"
          IgnoreExitCode="true"
          Condition="'$(IsWindows)' == 'true'">
      <Output TaskParameter="ExitCode" PropertyName="MavenFoundExitCode" />
    </Exec>

    <!-- Check if Maven exists in PATH (Linux/macOS) -->
    <Exec Command="which mvn"
          ContinueOnError="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low"
          IgnoreExitCode="true"
          Condition="'$(IsLinux)' == 'true' OR '$(IsMacOS)' == 'true'">
      <Output TaskParameter="ExitCode" PropertyName="MavenFoundExitCode" />
    </Exec>

    <PropertyGroup>
      <MavenNotFound Condition="'$(MavenFoundExitCode)' != '0'">true</MavenNotFound>
      <MavenAlreadyInstalled Condition="Exists('$(MavenInstallDir)\bin\mvn.cmd') OR Exists('$(MavenInstallDir)/bin/mvn')">true</MavenAlreadyInstalled>
    </PropertyGroup>

    <!-- Skip Maven download if already in PATH (e.g., from GitHub Actions) -->
    <Message Text="(Flink.JobGateway) Maven found in PATH, skipping download."
             Importance="High"
             Condition="'$(MavenNotFound)' != 'true'" />

    <!-- Download and install Maven if not found in PATH and not already in tools/ (Windows only) -->
    <Message Text="(Flink.JobGateway) Maven not found in PATH. Installing Maven $(MavenVersion) to $(MavenInstallDir)..."
             Importance="High"
             Condition="'$(IsWindows)' == 'true' AND '$(MavenNotFound)' == 'true' AND '$(MavenAlreadyInstalled)' != 'true'" />

    <!-- Create tools directory if it doesn't exist -->
    <MakeDir Directories="$(ToolsDir)" Condition="'$(IsWindows)' == 'true' AND '$(MavenNotFound)' == 'true' AND '$(MavenAlreadyInstalled)' != 'true'" />

    <!-- Download Maven ZIP (Windows only - use pwsh for cross-platform PowerShell) -->
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -Command &quot;Write-Host 'Downloading Maven from $(MavenDownloadUrl)...'; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -Uri '$(MavenDownloadUrl)' -OutFile '$(MavenZipPath)' -UseBasicParsing&quot;"
          Condition="'$(IsWindows)' == 'true' AND '$(MavenNotFound)' == 'true' AND '$(MavenAlreadyInstalled)' != 'true' AND !Exists('$(MavenZipPath)')"
          StandardOutputImportance="High" />

    <!-- Extract Maven ZIP (Windows only) -->
    <Message Text="(Flink.JobGateway) Extracting Maven to $(ToolsDir)..."
             Importance="High"
             Condition="'$(IsWindows)' == 'true' AND '$(MavenNotFound)' == 'true' AND '$(MavenAlreadyInstalled)' != 'true' AND Exists('$(MavenZipPath)')" />
    
    <Exec Command="pwsh -NoProfile -ExecutionPolicy Bypass -Command &quot;Expand-Archive -Path '$(MavenZipPath)' -DestinationPath '$(ToolsDir)' -Force&quot;"
          Condition="'$(IsWindows)' == 'true' AND '$(MavenNotFound)' == 'true' AND '$(MavenAlreadyInstalled)' != 'true' AND Exists('$(MavenZipPath)')"
          StandardOutputImportance="High" />

    <!-- Verify Maven was extracted successfully (Windows) -->
    <Error Condition="'$(IsWindows)' == 'true' AND '$(MavenNotFound)' == 'true' AND '$(MavenAlreadyInstalled)' != 'true' AND !Exists('$(MavenInstallDir)\bin\mvn.cmd')"
           Text="Maven installation failed. mvn.cmd not found at $(MavenInstallDir)\bin\mvn.cmd" />

    <Message Text="(Flink.JobGateway) Maven successfully installed to $(MavenInstallDir)"
             Importance="High"
             Condition="'$(IsWindows)' == 'true' AND '$(MavenNotFound)' == 'true' AND Exists('$(MavenInstallDir)\bin\mvn.cmd')" />

    <!-- Error if Maven not found on Linux/macOS (should be pre-installed in CI) -->
    <Error Condition="('$(IsLinux)' == 'true' OR '$(IsMacOS)' == 'true') AND '$(MavenNotFound)' == 'true' AND '$(MavenAlreadyInstalled)' != 'true'"
           Text="Maven not found in PATH on Linux/macOS. Please install Maven 3.9.11+ or ensure it's available in PATH. On GitHub Actions, Maven is installed via stCarolas/setup-maven@v4." />

    <!-- Determine which Maven command to use (cross-platform) -->
    <PropertyGroup>
      <!-- Priority 1: Use system Maven if found in PATH (e.g., from GitHub Actions) -->
      <MavenCommand Condition="'$(MavenFoundExitCode)' == '0'">mvn</MavenCommand>
      <!-- Priority 2: Use locally installed Maven if it exists (Windows) -->
      <MavenCommand Condition="'$(MavenCommand)' == '' AND '$(IsWindows)' == 'true' AND Exists('$(MavenInstallDir)\bin\mvn.cmd')">$(MavenInstallDir)\bin\mvn.cmd</MavenCommand>
      <!-- Priority 3: Use locally installed Maven if it exists (Linux/macOS) -->
      <MavenCommand Condition="'$(MavenCommand)' == '' AND ('$(IsLinux)' == 'true' OR '$(IsMacOS)' == 'true') AND Exists('$(MavenInstallDir)/bin/mvn')">$(MavenInstallDir)/bin/mvn</MavenCommand>
      <!-- Fallback: Use mvn from PATH (should be available if checks passed) -->
      <MavenCommand Condition="'$(MavenCommand)' == ''">mvn</MavenCommand>
    </PropertyGroup>

    <!-- Ensure JAVA_HOME is set and valid for Maven (cross-platform) -->
    <PropertyGroup>
      <!-- Check if current JAVA_HOME exists (Windows: java.exe, Linux/macOS: java) -->
      <JavaHomeExists Condition="'$(JAVA_HOME)' != '' AND ('$(IsWindows)' == 'true' AND Exists('$(JAVA_HOME)\bin\java.exe')) OR (('$(IsLinux)' == 'true' OR '$(IsMacOS)' == 'true') AND Exists('$(JAVA_HOME)/bin/java'))">true</JavaHomeExists>
      
      <!-- Check if JAVA_HOME version is compatible (JDK 17+, not JDK 1.8 or older) -->
      <!-- We check by looking for version indicators in the path or by exclusion of old versions -->
      <JavaHomeIsOldVersion Condition="'$(JavaHomeExists)' == 'true' AND ($([System.String]::Copy('$(JAVA_HOME)').Contains('jdk-1.8')) OR $([System.String]::Copy('$(JAVA_HOME)').Contains('jdk1.8')) OR $([System.String]::Copy('$(JAVA_HOME)').Contains('jdk-8')) OR $([System.String]::Copy('$(JAVA_HOME)').Contains('/8/')) OR $([System.String]::Copy('$(JAVA_HOME)').Contains('\8\')) OR $([System.String]::Copy('$(JAVA_HOME)').Contains('jre-1.8')))">true</JavaHomeIsOldVersion>
      
      <!-- JAVA_HOME is valid only if it exists AND is not an old version -->
      <JavaHomeIsValid Condition="'$(JavaHomeExists)' == 'true' AND '$(JavaHomeIsOldVersion)' != 'true'">true</JavaHomeIsValid>
      
      <!-- If JAVA_HOME is invalid or not set, try to detect Java installation (Windows only) -->
      <DetectedJavaHome Condition="'$(IsWindows)' == 'true' AND '$(JavaHomeIsValid)' != 'true' AND Exists('C:\Program Files\Java\jdk-25\bin\java.exe')">C:\Program Files\Java\jdk-25</DetectedJavaHome>
      <DetectedJavaHome Condition="'$(IsWindows)' == 'true' AND '$(DetectedJavaHome)' == '' AND Exists('C:\Program Files\Java\jdk-17\bin\java.exe')">C:\Program Files\Java\jdk-17</DetectedJavaHome>
      
      <!-- Use detected Java if current JAVA_HOME is invalid, otherwise use JAVA_HOME as-is -->
      <EffectiveJavaHome Condition="'$(JavaHomeIsValid)' == 'true'">$(JAVA_HOME)</EffectiveJavaHome>
      <EffectiveJavaHome Condition="'$(JavaHomeIsValid)' != 'true' AND '$(DetectedJavaHome)' != ''">$(DetectedJavaHome)</EffectiveJavaHome>
      <!-- On Linux/macOS, if JAVA_HOME is set but invalid detection failed, still use it (GitHub Actions sets valid paths) -->
      <EffectiveJavaHome Condition="'$(EffectiveJavaHome)' == '' AND ('$(IsLinux)' == 'true' OR '$(IsMacOS)' == 'true') AND '$(JAVA_HOME)' != ''">$(JAVA_HOME)</EffectiveJavaHome>
    </PropertyGroup>

    <Message Text="(Flink.JobGateway) Using JAVA_HOME: $(EffectiveJavaHome)" Importance="High" Condition="'$(EffectiveJavaHome)' != ''" />
    <Message Text="(Flink.JobGateway) INFO: Using detected Java instead of JAVA_HOME '$(JAVA_HOME)'"
             Importance="Low"
             Condition="'$(JavaHomeIsValid)' != 'true' AND '$(DetectedJavaHome)' != ''" />
    
    <Error Condition="'$(EffectiveJavaHome)' == ''"
           Text="JAVA_HOME is not set correctly and Java could not be auto-detected. Current JAVA_HOME: '$(JAVA_HOME)'. Please set JAVA_HOME to a valid JDK installation or install Java 17+." />

    <!-- Verify Maven works with the effective JAVA_HOME -->
    <Message Text="(Flink.JobGateway) Verifying Maven installation with Java..." Importance="High" />
    <Exec Command="&quot;$(MavenCommand)&quot; -version"
          StandardOutputImportance="High"
          EnvironmentVariables="JAVA_HOME=$(EffectiveJavaHome)" />

    <Message Text="(Flink.JobGateway) Build tools verification complete. Maven: $(MavenCommand)" Importance="High" />
  </Target>

  <!--
    Integrate the IR Java runner build directly into the Gateway build.
    This directly uses Maven to build the FlinkIRRunner project.
    
    Override:
      dotnet build -p:BuildFlinkRunner=false   - skip Java step
  -->
  <Target Name="BuildFlinkRunner"
          BeforeTargets="BeforeBuild"
          Condition="'$(BuildFlinkRunner)' != 'false'">

    <!-- Ensure FlinkIRRunner project exists -->
    <Error Condition="!Exists('$(FlinkIRRunnerDir)\pom.xml')"
           Text="FlinkIRRunner project missing. Expected pom.xml at $(FlinkIRRunnerDir)." />

    <!-- Require Java; fail if missing -->
    <Exec Command="java -version" />

    <!-- Maven is now ensured by EnsureBuildTools target -->

    <!-- Build Java 25 jar first; if it fails (e.g., JDK<25), continue and rely on Java 17 jar -->
    <Message Text="(Flink.JobGateway) Building FlinkIRRunner (Java 25)..." Importance="High" Condition="'$(IsJdk25)' == 'True'" />
    <Message Text="(Flink.JobGateway) Skipping Java 25 build (JDK 25 not detected)." Importance="High" Condition="'$(IsJdk25)' != 'True'" />
    <Exec Command="&quot;$(MavenCommand)&quot; -B clean package -DskipTests -Pjava25"
          WorkingDirectory="$(FlinkIRRunnerDir)"
          ContinueOnError="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="Low"
          IgnoreStandardErrorWarningFormat="true"
          EnvironmentVariables="JAVA_HOME=$(EffectiveJavaHome);MAVEN_OPTS=--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED"
          Condition="'$(IsJdk25)' == 'True'">
      <Output TaskParameter="ExitCode" PropertyName="Java25BuildExitCode" />
    </Exec>

    <!-- Always build Java 17 jar; this should succeed on JDK >=17 -->
    <!-- ContinueOnError=true for resilience against transient Maven failures (network issues, cache problems) -->
    <Message Text="(Flink.JobGateway) Building FlinkIRRunner (Java 17 compatibility)..." Importance="High" />
    <Exec Command="&quot;$(MavenCommand)&quot; -B package -DskipTests -Pjava17"
          WorkingDirectory="$(FlinkIRRunnerDir)"
          ContinueOnError="true"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="Low"
          IgnoreStandardErrorWarningFormat="true"
          EnvironmentVariables="JAVA_HOME=$(EffectiveJavaHome);MAVEN_OPTS=--add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED">
      <Output TaskParameter="ExitCode" PropertyName="Java17BuildExitCode" />
    </Exec>

    <!-- Validate jars output -->
    <!-- At least one jar must exist: prefer Java 25, but accept Java 17 -->
    <Error Condition="!Exists('$(FlinkIRRunnerJarPath25)') AND !Exists('$(FlinkIRRunnerJarPath17)')"
           Text="FlinkIRRunner jars missing after Maven build (neither Java 25 nor Java 17 produced). Check Maven output above for errors." />

    <!-- Copy jars next to the Gateway project for inclusion -->
    <Copy SourceFiles="$(FlinkIRRunnerJarPath25)"
          DestinationFiles="$(LocalJarPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(FlinkIRRunnerJarPath25)')" />
    <Copy SourceFiles="$(FlinkIRRunnerJarPath17)"
          DestinationFiles="$(MSBuildProjectDirectory)\flink-ir-runner-java17.jar"
          SkipUnchangedFiles="true"
          Condition="Exists('$(FlinkIRRunnerJarPath17)')" />
    <!-- DO NOT copy Java 17 jar as fallback - let tests use flink-ir-runner-java17.jar directly -->
    <!-- This ensures the 111 MB JAR with bundled SQL connectors is used, not the old 21 MB JAR -->
    
    <!-- Log jar outcomes -->
    <Message Text="(Flink.JobGateway) Java 25 jar ready at $(LocalJarPath)" Importance="High" Condition="Exists('$(MSBuildProjectDirectory)\flink-ir-runner.jar')" />
    <Message Text="(Flink.JobGateway) Java 17 jar ready at $(MSBuildProjectDirectory)\flink-ir-runner-java17.jar" Importance="High" Condition="Exists('$(MSBuildProjectDirectory)\flink-ir-runner-java17.jar')" />
  </Target>

  <!-- Ensure the JAR(s) are copied to the build output folder deterministically after build -->
  <Target Name="CopyRunnerJarsToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_OutDir>$([MSBuild]::EnsureTrailingSlash('$(OutDir)'))</_OutDir>
    </PropertyGroup>

    <!-- Copy Java 25 JAR if present -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\flink-ir-runner.jar"
          DestinationFiles="$(_OutDir)flink-ir-runner.jar"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\flink-ir-runner.jar')" />

    <!-- Always copy the Java 17 JAR with its proper name (do NOT rename to flink-ir-runner.jar) -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\flink-ir-runner-java17.jar"
          DestinationFiles="$(_OutDir)flink-ir-runner-java17.jar"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\flink-ir-runner-java17.jar')" />
  </Target>

  <!-- Copy runner jars into the publish directory so CI artifacts from publish include the jar -->
  <Target Name="CopyRunnerJarsToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_PublishDir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))</_PublishDir>
    </PropertyGroup>

    <!-- Copy Java 25 JAR if present -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\flink-ir-runner.jar"
          DestinationFiles="$(_PublishDir)flink-ir-runner.jar"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\flink-ir-runner.jar')" />
    
    <!-- Always copy the Java 17 JAR with its proper name (do NOT rename to flink-ir-runner.jar) -->
    <Copy SourceFiles="$(MSBuildProjectDirectory)\flink-ir-runner-java17.jar"
          DestinationFiles="$(_PublishDir)flink-ir-runner-java17.jar"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildProjectDirectory)\flink-ir-runner-java17.jar')" />
  </Target>

  <!-- Keep items for IDE visibility; do not rely on evaluation-time Exists for copying to output -->
  <ItemGroup>
    <None Include="flink-ir-runner.jar" Condition="Exists('$(MSBuildProjectDirectory)\flink-ir-runner.jar')" />
    <None Include="flink-ir-runner-java17.jar" Condition="Exists('$(MSBuildProjectDirectory)\flink-ir-runner-java17.jar')" />
  </ItemGroup>

</Project>
