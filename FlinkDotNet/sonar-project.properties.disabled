# SonarQube Project Configuration for Local Analysis
# This file enables running SonarQube analysis locally without visiting SonarCloud
# NOTE: sonar.sources and sonar.tests are NOT supported by SonarScanner for .NET
# The scanner automatically detects sources and tests from .csproj files

# Project identification
sonar.projectKey=devstress_flinkdotnet
sonar.organization=devstress
sonar.projectName=FlinkDotnet
sonar.projectVersion=1.0

# File exclusions (SonarScanner for .NET auto-detects sources from .csproj files)
sonar.exclusions=**/bin/**,**/obj/**,**/TestResults/**,**/CoverageReport/**,**/Demo/**,**/Backpressure/TestingSupportClasses.cs

# Test exclusions (scanner auto-detects test projects by naming and SDK)
sonar.test.exclusions=**/bin/**,**/obj/**

# Coverage exclusions
sonar.coverage.exclusions=**/*.Tests/**,**/TestResults/**

# Copy-paste detection exclusions
sonar.cpd.exclusions=**/*.Tests/**

# Coverage reports (generated by coverlet)
sonar.cs.opencover.reportsPaths=**/TestResults/**/coverage.opencover.xml
sonar.cs.vscoveragexml.reportsPaths=**/TestResults/**/coverage.cobertura.xml

# Language
sonar.language=cs

# Encoding
sonar.sourceEncoding=UTF-8

# SCM
sonar.scm.provider=git

# Additional settings
sonar.verbose=false
