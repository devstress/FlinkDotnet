# SonarQube Project Configuration for Local Analysis
# This file enables running SonarQube analysis locally without visiting SonarCloud

# Project identification
sonar.projectKey=devstress_flinkdotnet
sonar.organization=devstress
sonar.projectName=FlinkDotnet
sonar.projectVersion=1.0

# Source code location
sonar.sources=.
sonar.exclusions=**/bin/**,**/obj/**,**/TestResults/**,**/CoverageReport/**,**/*.Tests/**,**/Demo/**,**/Backpressure/TestingSupportClasses.cs

# Test locations
sonar.tests=.
sonar.test.inclusions=**/*.Tests/**/*.cs

# Coverage reports (generated by coverlet)
sonar.cs.opencover.reportsPaths=**/TestResults/**/coverage.opencover.xml
sonar.cs.vscoveragexml.reportsPaths=**/TestResults/**/coverage.cobertura.xml

# Language
sonar.language=cs

# Encoding
sonar.sourceEncoding=UTF-8

# SCM
sonar.scm.provider=git

# Additional settings
sonar.verbose=false
