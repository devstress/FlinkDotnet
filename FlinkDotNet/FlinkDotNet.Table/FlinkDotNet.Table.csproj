<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Authors>FlinkDotnet Team</Authors>
    <Description>.NET Table API for Apache Flink - SQL and Table operations matching PyFlink table module</Description>
    <PackageTags>Apache Flink;Streaming;Real-time;Data Processing;Table;SQL</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/devstress/FlinkDotnet</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../FlinkDotNet.Common/FlinkDotNet.Common.csproj" />
    <ProjectReference Include="../FlinkDotNet.DataStream/FlinkDotNet.DataStream.csproj" />
  </ItemGroup>

</Project>
