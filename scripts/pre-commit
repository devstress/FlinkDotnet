#!/bin/bash
# FlinkDotNet pre-commit hook
# Automatically runs dotnet format on changed C# files before committing

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Check if dotnet is available
if ! command -v dotnet &> /dev/null; then
    echo -e "${RED}Error: dotnet CLI not found. Please install .NET SDK.${NC}"
    exit 1
fi

# Get the list of staged .cs files
STAGED_CS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.cs$')

if [ -z "$STAGED_CS_FILES" ]; then
    echo -e "${GREEN}No C# files to format.${NC}"
    exit 0
fi

echo -e "${YELLOW}Formatting changed C# files...${NC}"

# Track if we need to re-stage files
NEEDS_RESTAGE=0

# Find all solution files
SOLUTIONS=()
for sln in $(find . -maxdepth 3 -name "*.sln" 2>/dev/null); do
    SOLUTIONS+=("$sln")
done

if [ ${#SOLUTIONS[@]} -eq 0 ]; then
    echo -e "${RED}Error: No solution files found.${NC}"
    exit 1
fi

# Format each solution that contains changed files
for SOLUTION in "${SOLUTIONS[@]}"; do
    SOLUTION_DIR=$(dirname "$SOLUTION")
    
    # Check if any staged files belong to this solution
    HAS_CHANGES=0
    for FILE in $STAGED_CS_FILES; do
        if [[ "$FILE" == "$SOLUTION_DIR"* ]]; then
            HAS_CHANGES=1
            break
        fi
    done
    
    if [ $HAS_CHANGES -eq 1 ]; then
        echo -e "${YELLOW}Formatting solution: $SOLUTION${NC}"
        
        # Run dotnet format
        if dotnet format "$SOLUTION" --verbosity quiet; then
            echo -e "${GREEN}✓ Formatted: $SOLUTION${NC}"
            
            # Check if formatting changed any files
            for FILE in $STAGED_CS_FILES; do
                if [[ "$FILE" == "$SOLUTION_DIR"* ]] && [ -f "$FILE" ]; then
                    # Check if file was modified by format
                    if ! git diff --quiet "$FILE"; then
                        echo -e "${YELLOW}  ↳ Restaging: $FILE${NC}"
                        git add "$FILE"
                        NEEDS_RESTAGE=1
                    fi
                fi
            done
        else
            echo -e "${RED}✗ Failed to format: $SOLUTION${NC}"
            echo -e "${RED}Please fix formatting errors and try again.${NC}"
            exit 1
        fi
    fi
done

if [ $NEEDS_RESTAGE -eq 1 ]; then
    echo -e "${GREEN}✓ Formatting complete. Formatted files have been restaged.${NC}"
else
    echo -e "${GREEN}✓ All files already properly formatted.${NC}"
fi

# Optional: Build check (commented out by default for performance)
# Uncomment the following lines to enforce build check before commit
# echo -e "${YELLOW}Building solutions...${NC}"
# for SOLUTION in "${SOLUTIONS[@]}"; do
#     if ! dotnet build "$SOLUTION" --configuration Release --no-restore --verbosity quiet > /dev/null 2>&1; then
#         echo -e "${RED}✗ Build failed: $SOLUTION${NC}"
#         echo -e "${RED}Please fix build errors and try again.${NC}"
#         exit 1
#     fi
# done
# echo -e "${GREEN}✓ Build successful.${NC}"

echo -e "${GREEN}✓ Pre-commit checks passed!${NC}"
exit 0
