<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <!-- Disable code analysis for test projects -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="9.3.1" />
    <PackageReference Include="Confluent.Kafka" Version="2.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="4.2.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LocalTesting.FlinkSqlAppHost\LocalTesting.FlinkSqlAppHost.csproj" />
    <ProjectReference Include="..\..\FlinkDotNet\FlinkDotNet\FlinkDotNet.csproj" SetConfiguration="Configuration=Release" />
    <ProjectReference Include="..\..\FlinkDotNet\Flink.JobBuilder\Flink.JobBuilder.csproj" SetConfiguration="Configuration=Release" />
  </ItemGroup>

  <!-- MSBuild Target: Force Release configuration for cross-solution FlinkDotNet references -->
  <Target Name="EnsureFlinkDotNetReleaseBuilds" BeforeTargets="ResolveProjectReferences">
    <Message Text="[LocalTesting.IntegrationTests] Ensuring FlinkDotNet projects build in Release configuration..." Importance="high" />
    
    <!-- Build FlinkDotNet in Release -->
    <MSBuild Projects="..\..\FlinkDotNet\FlinkDotNet\FlinkDotNet.csproj"
             Properties="Configuration=Release"
             Targets="Build" />
    
    <!-- Build Flink.JobBuilder in Release -->
    <MSBuild Projects="..\..\FlinkDotNet\Flink.JobBuilder\Flink.JobBuilder.csproj"
             Properties="Configuration=Release"
             Targets="Build" />
    
    <!-- Build Flink.JobGateway in Release (required dependency) -->
    <MSBuild Projects="..\..\FlinkDotNet\Flink.JobGateway\Flink.JobGateway.csproj"
             Properties="Configuration=Release"
             Targets="Build" />
    
    <Message Text="[LocalTesting.IntegrationTests] FlinkDotNet projects built in Release configuration successfully" Importance="high" />
  </Target>

  <!-- MSBuild Target: Copy Flink IR Runner JARs to test output directory -->
  <Target Name="CopyFlinkRunnerJarsToTestOutput" AfterTargets="Build">
    <PropertyGroup>
      <_GatewayOutputDir>..\..\FlinkDotNet\Flink.JobGateway\bin\$(Configuration)\net9.0</_GatewayOutputDir>
      <_TestOutDir>$([MSBuild]::EnsureTrailingSlash('$(OutDir)'))</_TestOutDir>
    </PropertyGroup>

    <Message Text="[LocalTesting.IntegrationTests] Copying Flink IR Runner JARs from Gateway output to test output..." Importance="high" />

    <!-- Copy flink-ir-runner.jar if it exists -->
    <Copy SourceFiles="$(_GatewayOutputDir)\flink-ir-runner.jar"
          DestinationFiles="$(_TestOutDir)flink-ir-runner.jar"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_GatewayOutputDir)\flink-ir-runner.jar')" />

    <!-- Copy flink-ir-runner-java17.jar if it exists -->
    <Copy SourceFiles="$(_GatewayOutputDir)\flink-ir-runner-java17.jar"
          DestinationFiles="$(_TestOutDir)flink-ir-runner-java17.jar"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_GatewayOutputDir)\flink-ir-runner-java17.jar')" />

    <!-- If only java17 exists, also copy it as the canonical name -->
    <Copy SourceFiles="$(_GatewayOutputDir)\flink-ir-runner-java17.jar"
          DestinationFiles="$(_TestOutDir)flink-ir-runner.jar"
          SkipUnchangedFiles="true"
          Condition="!Exists('$(_GatewayOutputDir)\flink-ir-runner.jar') AND Exists('$(_GatewayOutputDir)\flink-ir-runner-java17.jar')" />

    <Message Text="[LocalTesting.IntegrationTests] Flink IR Runner JARs copied to test output directory" Importance="high" />
  </Target>

</Project>
