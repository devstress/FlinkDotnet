{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "LocalTesting.WebApi.Services.FlinkJobManagementService": "Debug"
    }
  },
  "Flink": {
    "UseFlinkDotNet": true
  },
  "Temporal": {
    "ServerUrl": "localhost:7233",
    "AgentOptimization": {
      "EnableDynamicOptimization": true,
      "OptimizationInterval": "00:00:30",
      "MaxConcurrentActivities": 50,
      "MaxConcurrentWorkflowTasks": 50,
      "WorkerCount": 5,
      "PerformanceThresholds": {
        "MaxLatencyMs": 2000,
        "MinThroughputPerSecond": 50,
        "MaxErrorRate": 0.1,
        "MaxQueueDepth": 500
      }
    }
  }
}