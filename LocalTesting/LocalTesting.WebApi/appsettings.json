{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Flink": {
    "UseFlinkDotNet": true,
    "JobManagerUrl": "http://localhost:8081",
    "SqlGatewayUrl": "http://localhost:8083"
  },
  "Kafka": {
    "BootstrapServers": "kafka-broker-1:9092,kafka-broker-2:9092,kafka-broker-3:9092"
  },
  "AllowedHosts": "*"
}