<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <IsAspireIntegrationTest>true</IsAspireIntegrationTest>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="9.5.1" />
    <PackageReference Include="Aspire.Hosting.Kafka" Version="9.5.1" />
    <PackageReference Include="Confluent.Kafka" Version="2.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="4.2.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Temporalio" Version="1.1.2" />
    
    <!-- Use NuGet packages instead of project references -->
    <!-- NOTE: FlinkDotnet package must be available in a local feed or NuGet.org -->
    <!-- During release testing, add ./packages as a local NuGet source -->
    <PackageReference Include="FlinkDotnet" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReleasePackagesTesting.FlinkSqlAppHost\ReleasePackagesTesting.FlinkSqlAppHost.csproj" />
  </ItemGroup>

  <!-- Import Maven configuration (same as LocalTesting) -->
  <PropertyGroup>
    <MavenVersion>3.9.11</MavenVersion>
    <ToolsDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\tools'))</ToolsDir>
    <MavenInstallDir>$(ToolsDir)\apache-maven-$(MavenVersion)</MavenInstallDir>
    <MavenBinPath>$(MavenInstallDir)\bin</MavenBinPath>
    <JavaHome>$(JAVA_HOME)</JavaHome>
  </PropertyGroup>

  <!-- MSBuild Target: Build NativeFlinkJob Maven project (same as LocalTesting) -->
  <Target Name="BuildNativeFlinkJob" BeforeTargets="Build">
    <PropertyGroup>
      <_NativeFlinkJobDir>..\..\LocalTesting\NativeFlinkJob</_NativeFlinkJobDir>
      <_NativeFlinkJobJar>$(_NativeFlinkJobDir)\target\native-flink-kafka-job-1.0.0.jar</_NativeFlinkJobJar>
    </PropertyGroup>

    <Message Text="[ReleasePackagesTesting] Building NativeFlinkJob Maven project..." Importance="high" />
    
    <!-- Detect Maven command -->
    <PropertyGroup>
      <IsWindows Condition="'$(OS)' == 'Windows_NT'">true</IsWindows>
      <IsLinux Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Linux)))' == 'true'">true</IsLinux>
      <IsMacOS Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))' == 'true'">true</IsMacOS>
      <MavenCommand Condition="'$(IsWindows)' == 'true'">mvn.cmd</MavenCommand>
      <MavenCommand Condition="'$(IsLinux)' == 'true' OR '$(IsMacOS)' == 'true'">mvn</MavenCommand>
    </PropertyGroup>
    
    <!-- Build Maven project -->
    <Exec Command="$(MavenCommand) -B clean package -DskipTests"
          WorkingDirectory="$(_NativeFlinkJobDir)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="High"
          StandardErrorImportance="High"
          ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="MavenBuildExitCode" />
    </Exec>

    <Message Text="[ReleasePackagesTesting] NativeFlinkJob JAR built at $(_NativeFlinkJobJar)"
             Importance="high"
             Condition="Exists('$(_NativeFlinkJobJar)')" />
  </Target>

</Project>
