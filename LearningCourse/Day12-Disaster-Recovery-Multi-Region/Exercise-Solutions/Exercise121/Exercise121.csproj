<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Disable strict analyzers for learning projects -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsNotAsErrors />
    <NoWarn>$(NoWarn);S1118;S2325;S3903;S1481;S1450;S6966;S1075;S3358;S4457</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Project References -->
    <ProjectReference Include="../../../LearningCourse.Common/LearningCourse.Common.csproj" />
    
    <!-- Real Infrastructure Packages -->
    <PackageReference Include="Confluent.Kafka" Version="2.11.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
    
    <!-- Resilience Packages for Circuit Breaker -->
    <PackageReference Include="Polly" Version="8.5.0" />
  </ItemGroup>

</Project>
