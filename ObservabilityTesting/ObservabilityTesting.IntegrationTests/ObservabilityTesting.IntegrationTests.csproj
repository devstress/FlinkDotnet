<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <IsAspireIntegrationTest>true</IsAspireIntegrationTest>
    <!-- Disable code analysis for test projects -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Testing" Version="9.5.1" />
    <PackageReference Include="Aspire.Hosting.Kafka" Version="9.5.1" />
    <PackageReference Include="Confluent.Kafka" Version="2.11.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="NUnit" Version="4.2.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <!-- Conditional References: Use PackageReference for release validation, ProjectReference for normal tests -->
  <!-- This allows the same test project to be used for:
       1. Normal testing (observability-integration-tests.yml): Uses ProjectReference to build against local source
       2. Pre-release validation (release workflows): Uses PackageReference from local NuGet feed  
       3. Post-release validation (release workflows): Uses PackageReference from NuGet.org
       
       The mode is controlled by the RELEASE_VALIDATION_MODE environment variable set in GitHub workflows.
       When RELEASE_VALIDATION_MODE is not set (empty), ProjectReference is used.
       When RELEASE_VALIDATION_MODE is "PreRelease" or "PostRelease", PackageReference is used.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ObservabilityTesting.FlinkSqlAppHost\ObservabilityTesting.FlinkSqlAppHost.csproj" />
    <ProjectReference Include="..\SampleApp\SampleApp.csproj" />
  </ItemGroup>

  <!-- Normal mode: Use ProjectReference (default for observability-integration-tests.yml) -->
  <!-- When RELEASE_VALIDATION_MODE is not set, use local source code via ProjectReference -->
  <ItemGroup Condition="'$(RELEASE_VALIDATION_MODE)' == ''">
    <ProjectReference Include="..\..\FlinkDotNet\Flink.JobBuilder\Flink.JobBuilder.csproj" SetConfiguration="Configuration=Release" />
    <ProjectReference Include="..\..\FlinkDotNet\FlinkDotNet.Common\FlinkDotNet.Common.csproj" SetConfiguration="Configuration=Release" />
    <ProjectReference Include="..\..\FlinkDotNet\FlinkDotNet.DataStream\FlinkDotNet.DataStream.csproj" SetConfiguration="Configuration=Release" />
  </ItemGroup>

  <!-- PreRelease/PostRelease mode: Use PackageReference (for release workflows) -->
  <!-- When RELEASE_VALIDATION_MODE is set, use NuGet package for validation -->
  <!-- Wildcard version '*' is intentional - ensures latest available package is used -->
  <ItemGroup Condition="'$(RELEASE_VALIDATION_MODE)' == 'PreRelease' OR '$(RELEASE_VALIDATION_MODE)' == 'PostRelease'">
    <PackageReference Include="FlinkDotnet" Version="*" />
  </ItemGroup>

  <!-- MSBuild Target: Copy Flink IR Runner JARs to test output directory -->
  <Target Name="CopyFlinkRunnerJarsToTestOutput" AfterTargets="Build">
    <PropertyGroup>
      <_GatewayOutputDir>..\..\FlinkDotNet\FlinkDotNet.JobGateway\bin\$(Configuration)\net9.0</_GatewayOutputDir>
      <_TestOutDir>$([MSBuild]::EnsureTrailingSlash('$(OutDir)'))</_TestOutDir>
    </PropertyGroup>

    <Message Text="[ObservabilityTesting.IntegrationTests] Copying Flink IR Runner JARs from Gateway output to test output..." Importance="high" />

    <!-- Copy flink-ir-runner-java17.jar if it exists -->
    <Copy SourceFiles="$(_GatewayOutputDir)\flink-ir-runner-java17.jar" DestinationFiles="$(_TestOutDir)flink-ir-runner-java17.jar" SkipUnchangedFiles="true" Condition="Exists('$(_GatewayOutputDir)\flink-ir-runner-java17.jar')" />

    <Message Text="[ObservabilityTesting.IntegrationTests] Flink IR Runner JARs copied to test output directory" Importance="high" />
  </Target>

</Project>
