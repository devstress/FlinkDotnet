<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.1" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <AssemblyName>ObservabilityTesting.FlinkSqlAppHost</AssemblyName>
    <RootNamespace>ObservabilityTesting.FlinkSqlAppHost</RootNamespace>
    <!-- Disable code analysis for AppHost - it conflicts with Aspire testing requirements -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.5.1" />
    <PackageReference Include="Aspire.Hosting.Kafka" Version="9.5.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\FlinkDotNet\FlinkDotNet.JobGateway\FlinkDotNet.JobGateway.csproj">
      <SetConfiguration>Configuration=Release</SetConfiguration>
    </ProjectReference>
  </ItemGroup>

  <!-- Build Gateway Docker image during 'dotnet build' only, not during 'dotnet run' -->
  <Target Name="BuildGatewayDockerImage" BeforeTargets="Build" Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' == '' AND '$(MSBuildRuntimeType)' == 'Core'">
    <PropertyGroup>
      <!-- Use forward slashes for cross-platform compatibility -->
      <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</RepoRoot>
      <GatewayDockerfile>$(RepoRoot)/FlinkDotNet/FlinkDotNet.JobGateway/Dockerfile</GatewayDockerfile>
      <GatewayImageTag>flinkdotnet-gateway:local</GatewayImageTag>
    </PropertyGroup>

    <Message Text="[INFO] Building Gateway Docker image: $(GatewayImageTag)" Importance="High" />
    <Message Text="[INFO] Dockerfile location: $(GatewayDockerfile)" Importance="High" />
    <Message Text="[INFO] Build context: $(RepoRoot)" Importance="High" />

    <!-- Build the Docker image using the Gateway Dockerfile -->
    <Exec Command="docker build -t $(GatewayImageTag) -f &quot;$(GatewayDockerfile)&quot; &quot;$(RepoRoot)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="High"
          StandardErrorImportance="High"
          ContinueOnError="false" />

    <Message Text="[INFO] Gateway Docker image built successfully: $(GatewayImageTag)" Importance="High" />
  </Target>

</Project>
