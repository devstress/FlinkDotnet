<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.1" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <AssemblyName>ObservabilityTesting.FlinkSqlAppHost</AssemblyName>
    <RootNamespace>ObservabilityTesting.FlinkSqlAppHost</RootNamespace>
    <!-- Disable code analysis for AppHost - it conflicts with Aspire testing requirements -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.5.1" />
    <PackageReference Include="Aspire.Hosting.Kafka" Version="9.5.1" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>

  <!-- Initialize SKIP_DOCKER_BUILD property from environment variable -->
  <!-- This must be evaluated early so BuildGatewayDockerImage target condition can use it -->
  <PropertyGroup>
    <SKIP_DOCKER_BUILD Condition="'$(SKIP_DOCKER_BUILD)' == ''">$([System.Environment]::GetEnvironmentVariable('SKIP_DOCKER_BUILD'))</SKIP_DOCKER_BUILD>
  </PropertyGroup>

  <!-- Build FlinkDotNet JobGateway Docker image during 'dotnet build' only, not during 'dotnet run' or 'dotnet test' -->
  <!-- Skip if SKIP_DOCKER_BUILD is set (for faster test execution) or if running in test mode -->
  <PropertyGroup>
    <GatewayImageTag>flinkdotnet-gateway:local</GatewayImageTag>
  </PropertyGroup>

  <Target Name="CheckGatewayDockerImage" BeforeTargets="Build">
    <!-- Check if Docker image already exists (only if SKIP_DOCKER_BUILD is not already set) -->
    <Exec Command="docker images -q $(GatewayImageTag) 2&gt;nul || docker images -q $(GatewayImageTag) 2&gt;/dev/null"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          ContinueOnError="true"
          Condition="'$(SKIP_DOCKER_BUILD)' != 'true'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GatewayImageExists" />
    </Exec>
    
    <!-- Set SkipGatewayDockerBuild based on conditions -->
    <PropertyGroup>
      <SkipGatewayDockerBuild Condition="'$(GatewayImageExists)' != '' OR '$(SKIP_DOCKER_BUILD)' == 'true' OR '$(IsTestProject)' == 'true'">true</SkipGatewayDockerBuild>
    </PropertyGroup>
    
    <Message Text="[INFO] Gateway Docker image check: $(GatewayImageTag) - Image exists: $(GatewayImageExists)" Importance="High" Condition="'$(SkipGatewayDockerBuild)' != 'true'" />
    <Message Text="[INFO] Skipping Gateway Docker image build (SKIP_DOCKER_BUILD=$(SKIP_DOCKER_BUILD), Image exists=$(GatewayImageExists), IsTestProject=$(IsTestProject))" Importance="High" Condition="'$(SkipGatewayDockerBuild)' == 'true'" />
  </Target>

  <Target Name="BuildGatewayDockerImage" 
          BeforeTargets="Build" 
          AfterTargets="CheckGatewayDockerImage"
          Condition="'$(DOTNET_RUNNING_IN_CONTAINER)' == '' AND '$(MSBuildRuntimeType)' == 'Core' AND '$(SkipGatewayDockerBuild)' != 'true'">
    <PropertyGroup>
      <!-- Use forward slashes for cross-platform compatibility -->
      <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../'))</RepoRoot>
      <GatewayDockerfile>$(RepoRoot)/FlinkDotNet/FlinkDotNet.JobGateway/Dockerfile</GatewayDockerfile>
    </PropertyGroup>

    <Message Text="[INFO] Building FlinkDotNet JobGateway Docker image: $(GatewayImageTag)" Importance="High" />
    <Message Text="[INFO] Dockerfile location: $(GatewayDockerfile)" Importance="High" />
    <Message Text="[INFO] Build context: $(RepoRoot)" Importance="High" />

    <!-- Build the Docker image using the JobGateway Dockerfile -->
    <Exec Command="docker build -t $(GatewayImageTag) -f &quot;$(GatewayDockerfile)&quot; &quot;$(RepoRoot)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="High"
          StandardErrorImportance="High"
          ContinueOnError="false" />

    <Message Text="[INFO] FlinkDotNet JobGateway Docker image built successfully: $(GatewayImageTag)" Importance="High" />
  </Target>

</Project>
